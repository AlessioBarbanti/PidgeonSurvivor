[resource]
script = ExtResource("1_definition")
id = &"aleo_thermal_shock"
title = "Shock Termico"
description = "Congela un'area per un istante, poi la fa esplodere di calore: i nemici ancora brinati subiscono danno raddoppiato."
effect_summary = "BRINA 1,2 S · -55% VELOCITÀ · POI 14 DANNI (X2 SUI BRINATI) · RAGGIO 200 · RICARICA 12 S"
icon = ExtResource("2_icon")
cooldown_seconds = 12.0
duration_seconds = 1.2
area_radius = 200.0
damage = 14.0
effect_id = &"thermal_shock"
effect_parameters = {
"bloom_seconds": 0.35,
"shock_multiplier": 2.0,
"slow_factor": 0.45
}
tags = Array[StringName]([&"control", &"damage", &"burst", &"copy_compatible"])
rank_snapshots = Array[ExtResource("3_rank")]([SubResource("Rank_1"), SubResource("Rank_2"), SubResource("Rank_3"), SubResource("Rank_4"), SubResource("Rank_5")])
