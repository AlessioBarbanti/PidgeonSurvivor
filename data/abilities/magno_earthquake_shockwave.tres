[resource]
script = ExtResource("1_definition")
id = &"magno_earthquake_shockwave"
title = "Onda d'Urto Tellurica"
description = "Genera un'onda d'urto che danneggia e respinge i nemici vicini, più forte quanto più slancio Magno ha accumulato."
effect_summary = "DANNO 20 · RAGGIO 220 · SPINTA 300 · RICARICA 8 S"
icon = ExtResource("2_icon")
cooldown_seconds = 8.0
duration_seconds = 0.0
area_radius = 220.0
damage = 20.0
effect_id = &"earthquake_shockwave"
effect_parameters = {
"knockback_force": 300.0,
"stun_duration": 0.2,
"visual_duration": 0.35,
"momentum_damage_bonus_max": 0.5,
"momentum_knockback_bonus_max": 0.4
}
tags = Array[StringName]([&"radial", &"damage", &"crowd_control", &"copy_compatible"])
rank_snapshots = Array[ExtResource("3_rank")]([SubResource("Rank_1"), SubResource("Rank_2"), SubResource("Rank_3"), SubResource("Rank_4"), SubResource("Rank_5")])
