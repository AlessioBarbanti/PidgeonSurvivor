[resource]
script = ExtResource("1_page")
id = &"enemies"
eyebrow = "NEMICI"
title = "LEGGI LA SAGOMA. REAGISCI."
body = "Base: ti insegue. Sciamatore: rapido e in gruppo. Corazzato: lento e resistente. Divisore: si moltiplica. Tiratore: si ferma e spara."
