[resource]
script = ExtResource("1_definition")
id = &"bea"
display_name = "Bea"
role = "Evasione e riposizionamento."
tags = Array[StringName]([&"mobility", &"evasion"])
passive_title = "Sesto Senso Equino"
passive_description = "Ogni 9 secondi annulla il colpo che la colpirebbe: Bea scarta d'istinto lontano dal pericolo e resta invulnerabile per un istante."
