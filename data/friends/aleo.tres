[resource]
script = ExtResource("1_definition")
id = &"aleo"
display_name = "Aleo"
role = "Sbalzo termico e gestione del danno."
tags = Array[StringName]([&"survival", &"damage", &"control"])
passive_title = "Termostato Interno"
passive_description = "Sopra metà vita scalda e infligge più danno; sotto metà raffredda, incassa meno e la brina rallenta e logora i nemici vicini."
passive_id = &"aleo_internal_thermostat"
passive_parameters = {
"cold_aura_damage_per_second": 12.0,
"cold_aura_radius": 140.0,
"cold_aura_tick_interval": 0.25,
"cold_damage_reduction": 0.25,
"cold_slow_factor": 0.7,
"hot_damage_multiplier": 1.2,
"hot_threshold": 0.5
}
active_ability_id = &"aleo_thermal_shock"
active_ability_title = "Shock Termico"
active_ability_description = "Congela un'area per un istante, poi la fa esplodere di calore: i nemici ancora brinati subiscono danno raddoppiato."
base_health_multiplier = 1.1
base_move_speed_multiplier = 0.95
base_fire_rate_multiplier = 1.05
evil_display_name = "Evil Aleo"
portrait = SubResource("AtlasTexture_portrait")
evil_portrait = SubResource("AtlasTexture_evil")
portrait_placeholder = SubResource("AtlasTexture_portrait")
evil_portrait_placeholder = SubResource("AtlasTexture_evil")
portrait_source = "Eldiran, 32x32 RPG Character Sprites, CC0 1.0"
portraits_are_placeholders = true
selection_portrait = ExtResource("4_selection")
passive_icon = ExtResource("5_passive")
gameplay_idle_right = SubResource("AtlasTexture_gameplay_idle")
gameplay_walk_right_frames = Array[Texture2D]([SubResource("AtlasTexture_gameplay_walk_a"), SubResource("AtlasTexture_gameplay_idle"), SubResource("AtlasTexture_gameplay_walk_b"), SubResource("AtlasTexture_gameplay_idle")])
content_approved = true
portraits_approved = true
approved_by = "Proprietario del progetto"
approval_date = "2026-08-28"
approval_reference = "Rework termotecnico approvato dal proprietario nella sessione Claude Code del 28/08/2026."
