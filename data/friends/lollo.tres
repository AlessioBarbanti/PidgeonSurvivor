[resource]
script = ExtResource("1_definition")
id = &"lollo"
display_name = "Lollo"
role = "Velocità, caos e imprevedibilità."
tags = Array[StringName]([&"mobility", &"random", &"copy"])
passive_title = "Iperfocus ADHD"
passive_description = "Alterna a intervalli casuali una fase di iperfocus fulminea e una fase distratta più lenta; ogni nemico ucciso accorcia la distrazione."
passive_id = &"lollo_hyperactivity"
passive_parameters = {
"distracted_duration_max": 6.0,
"distracted_duration_min": 3.0,
"distracted_fire_rate_multiplier": 0.8,
"distracted_move_speed_multiplier": 0.85,
"distraction_seconds_per_kill": 0.15,
"focus_duration_max": 8.0,
"focus_duration_min": 4.0,
"focus_fire_rate_multiplier": 1.45,
"focus_move_speed_multiplier": 1.35
}
active_ability_id = &"lollo_random_cosplay"
active_ability_title = "Cosplay Casuale"
active_ability_description = "Estrae in anticipo l'abilità di un altro personaggio e la mostra sul pulsante: la prossima attivazione lancia quella."
base_health_multiplier = 0.9
base_move_speed_multiplier = 1.05
base_fire_rate_multiplier = 1.05
base_damage_multiplier = 1.0
base_xp_gain_multiplier = 1.05
base_pickup_radius_multiplier = 0.93
base_damage_taken_multiplier = 1.04
base_critical_chance_bonus = 0.06
evil_display_name = "Evil Lollo"
portrait = ExtResource("7_portrait")
evil_portrait = ExtResource("6_evil_portrait")
