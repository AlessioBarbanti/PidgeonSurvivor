active_ability_description = "Genera un clone che balla reggaeton e diventa il bersaglio dei nemici vicini."
base_health_multiplier = 0.95
base_move_speed_multiplier = 1.0
base_fire_rate_multiplier = 1.1
evil_display_name = "Evil Marghe"
portrait = SubResource("AtlasTexture_portrait")
