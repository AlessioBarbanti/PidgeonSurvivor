# Godot caches and generated imports.
/.godot/
*.translation

# Local exports and generated Android Gradle template.
/exports/
/android/build/
/android/.gradle/
/android/.build_version
local.properties
*.apk
*.aab

# Signing material must remain outside version control.
*.keystore
*.jks
*.p12
*.pfx

# IDE and operating-system metadata.
/.idea/
/.vscode/
.DS_Store
Thumbs.db

#Private
# Reference visive riservate del cast (mai asset runtime, mai da pushare): ignora
# ogni cartella per personaggio e qualunque file al suo interno, cosicche'
# nuove reference non richiedano una riga dedicata. README.md e .gdignore
# restano tracciati perche' vivono direttamente in references/, non in una
# sottocartella per personaggio.
docs/characters/references/*/
